{
  "exe": "local/ds41-engine-local.sh",
  "args": [
    "-m",
    "/srv/hive-engine/model/V41-GSQ.gguf",
    "--backend",
    "cuda",
    "--experts",
    "gpu",
    "--rank",
    "/srv/hive-engine/model/rank.bin",
    "--threads",
    "12",
    "--pf-b",
    "0",
    "--ctx",
    "32768",
    "--stop",
    "1",
    "--kv-q8",
    "--prompt-batch",
    "8192",
    "--arena-gib",
    "4",
    "--engram",
    "/srv/hive-engine/engram/layers14:/srv/hive-engine/engram/layers1",
    "--prefill-chunk",
    "1024"
  ],
  "env": {
    "LD_LIBRARY_PATH": "/srv/hive-engine/lib",
    "HIP_VISIBLE_DEVICES": "1",
    "STRATA_NO_LARGEPAGES": "1",
    "STRATA_ADVISE_AHEAD": "6",
    "STRATA_ADVISE_PREV": "1",
    "STRATA_DECODE_DIRECT": "0",
    "GGML_NO_BACKTRACE": "1",
    "GGML_CUDA_DISABLE_GRAPHS": "1",
    "STRATA_PRESTAGE_GIB": "1.5",
    "STRATA_SERVE_PASS_BIAS": "0",
    "DS41_EXE": "/srv/hive-engine/app/build-hip-pre/ds41_generate",
    "STRATA_TEXT_LOG": "/srv/hive-engine/logs/ds41-text.log",
    "STRATA_DENSE_REQUANT": "q4_K",
    "STRATA_SERVE_PASS_M": "16",
    "STRATA_D3_PF": "1",
    "STRATA_SERVE_STEP_MAX": "0",
    "STRATA_ADVISE_TOP": "8",
    "STRATA_WAVE_THREADS": "16",
    "STRATA_WAVE_PARTS": "16"
  },
  "cwd": "/srv/hive-engine/app",
  "tokenizer": "/srv/hive-engine/model/tokenizer",
  "model_name": "deepseek-v4.1-flash-gsq",
  "log": "/srv/hive-engine/logs/engine.log",
  "port": 8150,
  "backend": "hip",
  "gpu": 0,
  "sampling": {
    "temperature": 1.0,
    "top_p": 0.95
  },
  "reasoning_loop_recovery": "recover",
  "reasoning_budget_tokens": 2048,
  "reasoning_close_retry": true,
  "api_monitor": true
}
