[Unit]
Description=DeepSeek V4.1 engine (spare GPU, localhost)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hive-engine
Group=hive-engine
SupplementaryGroups=video render
WorkingDirectory=/srv/hive-engine/app
Environment=HOME=/srv/hive-engine/home
Environment=LD_LIBRARY_PATH=/srv/hive-engine/lib
Environment=HIP_VISIBLE_DEVICES=1
Environment=STRATA_HOME=/srv/hive-engine/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /srv/hive-engine/app/tools/v41/serve/serve_ds41.py --engine strata --config /etc/hive-engine/ds41.json --port 8150
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=/home
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=12G
MemoryHigh=9G
MemorySwapMax=0
ReadWritePaths=/srv/hive-engine
BindReadOnlyPaths=@MODEL_SRC@:/srv/hive-engine/model
BindReadOnlyPaths=@ENGRAM1_SRC@:/srv/hive-engine/engram/layers1
BindReadOnlyPaths=@ENGRAM14_SRC@:/srv/hive-engine/engram/layers14

[Install]
WantedBy=multi-user.target
