[Unit]
Description=Hive Studio (dedicated AI user)
Documentation=file:///srv/hive/app/docs/AI-USER.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hive
Group=hive
SupplementaryGroups=video render
WorkingDirectory=/srv/hive/app
EnvironmentFile=-/srv/hive/hive.env
Environment=HOME=/srv/hive/home
Environment=HIVE_HOME=/srv/hive
Environment=HIVE_STATE_DIR=/srv/hive/state
Environment=DSH_HOME=/srv/hive/dsh
Environment=HIVE_TOOL_URL=http://127.0.0.1:8765
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/hive/venv/bin/python -m harness --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# read-only, not yes: /run/user must stay visible for the rootless Docker
# socket.  /home/penis is still unreadable because the human home is 0700/0750
# and hive is not in its group.
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=/srv/hive -/run/user/952

[Install]
WantedBy=multi-user.target
