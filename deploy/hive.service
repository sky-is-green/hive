[Unit]
Description=Hive Studio (dedicated AI user)
Documentation=file:///srv/hive-ai/app/docs/AI-USER.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The whole application runs as the disposable AI user.  GUARD keeps the
# separate 'hive' account, so this must never be User=hive.
User=hive-ai
Group=hive-ai
SupplementaryGroups=video render
WorkingDirectory=/srv/hive-ai/app
EnvironmentFile=-/etc/hive/hive.env
Environment=HOME=/srv/hive-ai/home
Environment=HIVE_HOME=/srv/hive-ai
Environment=HIVE_STATE_DIR=/srv/hive-ai/state
Environment=DSH_HOME=/srv/hive-ai/dsh
Environment=HIVE_DSH_SESSION_ROOT=/srv/hive-ai/dsh/sessions
Environment=HARNESS_PROVIDERS_FILE=/srv/hive-ai/state/providers.local.json
Environment=HIVE_TOOL_URL=http://127.0.0.1:8765
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# The application copy is read-only, so pass absolute mutable paths instead
# of letting the CLI defaults resolve under WorkingDirectory.
ExecStart=/srv/hive-ai/venv/bin/python -m harness --host 127.0.0.1 --port 8765 --state-dir /srv/hive-ai/state --log-dir /srv/hive-ai/logs --providers-file /srv/hive-ai/state/providers.local.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# ProtectHome=read-only would also make /run/user read-only, and systemd does
# not expand %U inside ReadWritePaths.  Hide the human and root homes directly
# instead; /run/user is a per-user tmpfs that remains writable under
# ProtectSystem=strict, so the rootless Docker socket keeps working.
ProtectHome=no
InaccessiblePaths=/home -/root
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=/srv/hive-ai

[Install]
WantedBy=multi-user.target
