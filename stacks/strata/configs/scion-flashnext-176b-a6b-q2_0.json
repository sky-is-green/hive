{
  "exe": "build-hip-0.2.10/strata",
  "args": [
    "--pack",
    "${SCION_MODELS}/pack-q2-ab",
    "--native",
    "${SCION_MODELS}/Scion-FlashNext-176B-A6B-Q2_0.gguf",
    "--ple-gguf",
    "${SCION_MODELS}/Scion-FlashNext-176B-A6B-Q2_0.gguf",
    "--embd-gguf",
    "${SCION_MODELS}/scion-embd-bf16.gguf",
    "--expert-profile",
    "${STRATA_REPO}/data/expert-profile.bin",
    "--expert-cache",
    "auto",
    "--prefill",
    "4096",
    "--spec",
    "4",
    "--spec-min-p",
    "0.5",
    "--mtp",
    "${STRATA_DATA}/mtp/rt",
    "--max-context",
    "8192",
    "--ple-io",
    "direct",
    "--mmap-experts",
    "--vram-reserve-mib",
    "3072",
    "--pool-workers",
    "15",
    "--pcie-frac",
    "0",
    "--pipeline-windows",
    "2"
  ],
  "cwd": "${STRATA_REPO}",
  "tokenizer": "${SCION_MODELS}/pack-q2-ab/tokenizer",
  "model_name": "scion-flashnext-176b-a6b-q2_0",
  "log": "logs/strata_scion.engine.log",
  "lib_dirs": [
    "/opt/rocm/lib"
  ],
  "env": {
    "STRATA_PREFILL_MMQ": "1",
    "STRATA_PREFILL_RING": "96",
    "STRATA_IO_THREADS": "32"
  },
  "port": 8081,
  "backend": "hip",
  "gpu": [
    0,
    1
  ],
  "gpus_asked": true,
  "layer_split": "auto",
  "answer_room": true
}
