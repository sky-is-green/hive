{
  "version": 1,
  "backends": {
    "vulkan": {
      "label": "Vulkan",
      "binary_dir": "tools/backends/vulkan",
      "accelerators": ["amd", "nvidia", "intel"],
      "notes": "Cross-vendor llama.cpp build; the portable fallback.",
      "release": {
        "repo": "ggml-org/llama.cpp",
        "assets": {
          "linux-x64": "llama-*-bin-ubuntu-vulkan-x64.tar.gz",
          "linux-arm64": "llama-*-bin-ubuntu-vulkan-arm64.tar.gz",
          "win-x64": "llama-*-bin-win-vulkan-x64.zip",
          "win-arm64": "llama-*-bin-win-vulkan-arm64.zip"
        }
      }
    },
    "rocm": {
      "label": "ROCm (HIP)",
      "binary_dir": "tools/backends/rocm",
      "accelerators": ["amd"],
      "notes": "AMD only; the prism AMD engine build.",
      "release": {
        "repo": "ggml-org/llama.cpp",
        "assets": {
          "linux-x64": "llama-*-bin-ubuntu-rocm-*-x64.tar.gz",
          "win-x64": "llama-*-bin-win-rocm-*-x64.zip"
        }
      }
    },
    "cuda": {
      "label": "CUDA",
      "binary_dir": "tools/backends/cuda",
      "accelerators": ["nvidia"],
      "notes": "NVIDIA only."
    },
    "cpu": {
      "label": "CPU",
      "binary_dir": "tools/backends/cpu",
      "accelerators": ["cpu"],
      "notes": "No GPU offload; the last resort.",
      "release": {
        "repo": "ggml-org/llama.cpp",
        "assets": {
          "linux-x64": "llama-*-bin-ubuntu-x64.tar.gz",
          "linux-arm64": "llama-*-bin-ubuntu-arm64.tar.gz"
        }
      }
    },
    "sycl": {
      "label": "SYCL (oneAPI)",
      "binary_dir": "tools/backends/sycl",
      "accelerators": ["intel"],
      "notes": "Intel GPUs."
    },
    "scion": {
      "label": "Scion (moe-corr-runtime)",
      "binary_dir": "tools/backends/scion",
      "accelerators": ["amd", "nvidia"],
      "notes": "The fork with the ternary PQ2_0 container and the draft-MTP sidecar."
    }
  }
}
