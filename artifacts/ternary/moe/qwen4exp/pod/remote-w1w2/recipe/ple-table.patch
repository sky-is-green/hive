+// ====================== Q3X32 / Q2X32 (PLE table, block 32, mid-rise) ======================
+// One fp16 scale per 32-element block: s = amax/(L-1); codes are uniform
+// mid-rise levels, decode x = (2c - (L-1))*s. See the Scion design note
+// PLE-TABLE-TYPES.md for the rule and the real-row measurements.
+
+void quantize_row_q3x32_ref(const float * GGML_RESTRICT x, block_q3x32 * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK3X32 == 0);
+    const int64_t nb = k / QK3X32;
+
+    for (int64_t i = 0; i < nb; i++) {
+        const float * xb = x + i*QK3X32;
+
+        float amax = 0.0f;
+        for (int j = 0; j < QK3X32; j++) {
+            amax = MAX(amax, fabsf(xb[j]));
+        }
+
+        // least-squares scale for the fixed codebook: alternate nearest-level
+        // assignment and s = sum(x*lv)/sum(lv*lv), then round s to fp16
+        float s = amax / kQ3x32_levels[7];
+        for (int it = 0; it < 3; it++) {
+            float num = 0.0f;
+            float den = 0.0f;
+            for (int j = 0; j < QK3X32; j++) {
+                float best = fabsf(xb[j] - s*kQ3x32_levels[0]);
+                int bc = 0;
+                for (int l = 1; l < 8; l++) {
+                    const float dist = fabsf(xb[j] - s*kQ3x32_levels[l]);
+                    if (dist < best) { best = dist; bc = l; }
+                }
+                num += xb[j]*kQ3x32_levels[bc];
+                den += kQ3x32_levels[bc]*kQ3x32_levels[bc];
+            }
+            s = den > 0.0f ? num/den : 0.0f;
+        }
+
+        y[i].d = GGML_FP32_TO_FP16(s);
+        const float sd = GGML_FP16_TO_FP32(y[i].d);
+
+        memset(y[i].qs, 0, sizeof(y[i].qs));
+        memset(y[i].qh, 0, sizeof(y[i].qh));
+        for (int j = 0; j < QK3X32; j++) {
+            float best = fabsf(xb[j] - sd*kQ3x32_levels[0]);
+            int bc = 0;
+            for (int l = 1; l < 8; l++) {
+                const float dist = fabsf(xb[j] - sd*kQ3x32_levels[l]);
+                if (dist < best) { best = dist; bc = l; }
+            }
+            y[i].qs[j/4] |= (uint8_t) (bc & 3) << ((j % 4)*2);
+            y[i].qh[j/8] |= (uint8_t) (bc >> 2) << (j % 8);
+        }
+    }
+}
+
+void dequantize_row_q3x32(const block_q3x32 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK3X32 == 0);
+    const int64_t nb = k / QK3X32;
+
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = GGML_FP16_TO_FP32(x[i].d);
+
+        for (int j = 0; j < QK3X32; j++) {
+            const int c = (x[i].qs[j/4] >> ((j % 4)*2) & 3) | ((x[i].qh[j/8] >> (j % 8) & 1) << 2);
+            y[i*QK3X32 + j] = kQ3x32_levels[c] * d;
+        }
+    }
+}
+
+size_t quantize_q3x32(const float * GGML_RESTRICT src, void * GGML_RESTRICT dst, int64_t nrow, int64_t n_per_row, const float * quant_weights) {
+    (void)quant_weights; // table rows are quantized from their own values; an imatrix has no role
+    const size_t row_size = ggml_row_size(GGML_TYPE_Q3X32, n_per_row);
+    char * qrow = (char *)dst;
+    for (int64_t row = 0; row < nrow; ++row) {
+        quantize_row_q3x32_ref(src, (block_q3x32 *)qrow, n_per_row);
+        src  += n_per_row;
+        qrow += row_size;
+    }
+    return nrow * row_size;
+}
+
+void quantize_row_q2x32_ref(const float * GGML_RESTRICT x, block_q2x32 * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK2X32 == 0);
+    const int64_t nb = k / QK2X32;
+    static const float levels[4] = {-3.0f, -1.0f, 1.0f, 3.0f};
+
+    for (int64_t i = 0; i < nb; i++) {
+        const float * xb = x + i*QK2X32;
+
+        float amax = 0.0f;
+        for (int j = 0; j < QK2X32; j++) {
+            amax = MAX(amax, fabsf(xb[j]));
+        }
+
+        // same least-squares scale as Q3X32, mid-rise level set
+        float s = amax / 3.0f;
+        for (int it = 0; it < 3; it++) {
+            float num = 0.0f;
+            float den = 0.0f;
+            for (int j = 0; j < QK2X32; j++) {
+                float best = fabsf(xb[j] - s*levels[0]);
+                int bc = 0;
+                for (int l = 1; l < 4; l++) {
+                    const float dist = fabsf(xb[j] - s*levels[l]);
+                    if (dist < best) { best = dist; bc = l; }
+                }
+                num += xb[j]*levels[bc];
+                den += levels[bc]*levels[bc];
+            }
+            s = den > 0.0f ? num/den : 0.0f;
+        }
+
+        y[i].d = GGML_FP32_TO_FP16(s);
+        const float sd = GGML_FP16_TO_FP32(y[i].d);
+
+        memset(y[i].qs, 0, sizeof(y[i].qs));
+        for (int j = 0; j < QK2X32; j++) {
+            float best = fabsf(xb[j] - sd*levels[0]);
+            int bc = 0;
+            for (int l = 1; l < 4; l++) {
+                const float dist = fabsf(xb[j] - sd*levels[l]);
+                if (dist < best) { best = dist; bc = l; }
+            }
+            y[i].qs[j/4] |= (uint8_t) bc << ((j % 4)*2);
+        }
+    }
+}
+
+void dequantize_row_q2x32(const block_q2x32 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK2X32 == 0);
+    const int64_t nb = k / QK2X32;
+
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = GGML_FP16_TO_FP32(x[i].d);
+
+        for (int j = 0; j < QK2X32; j++) {
+            const int c = (x[i].qs[j/4] >> ((j % 4)*2)) & 3;
+            y[i*QK2X32 + j] = (2*c - 3) * d;
+        }
+    }
+}
+
+size_t quantize_q2x32(const float * GGML_RESTRICT src, void * GGML_RESTRICT dst, int64_t nrow, int64_t n_per_row, const float * quant_weights) {
+    (void)quant_weights; // table rows are quantized from their own values; an imatrix has no role
+    const size_t row_size = ggml_row_size(GGML_TYPE_Q2X32, n_per_row);
+    char * qrow = (char *)dst;
+    for (int64_t row = 0; row < nrow; ++row) {
+        quantize_row_q2x32_ref(src, (block_q2x32 *)qrow, n_per_row);
+        src  += n_per_row;
+        qrow += row_size;
+    }
+    return nrow * row_size;
+}
+
+void quantize_row_q4x160_ref(const float * GGML_RESTRICT x, block_q4x160 * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK4X160 == 0);
+    const int64_t nb = k / QK4X160;
+
+    for (int64_t i = 0; i < nb; i++) {
+        const float * xb = x + i*QK4X160;
+
+        float amax = 0.0f;
+        for (int j = 0; j < QK4X160; j++) {
+            amax = MAX(amax, fabsf(xb[j]));
+        }
+
+        // least-squares scale for the fixed 16-level codebook
+        float s = amax / kQ4x160_levels[15];
+        for (int it = 0; it < 3; it++) {
+            float num = 0.0f;
+            float den = 0.0f;
+            for (int j = 0; j < QK4X160; j++) {
+                float best = fabsf(xb[j] - s*kQ4x160_levels[0]);
+                int bc = 0;
+                for (int l = 1; l < 16; l++) {
+                    const float dist = fabsf(xb[j] - s*kQ4x160_levels[l]);
+                    if (dist < best) { best = dist; bc = l; }
+                }
+                num += xb[j]*kQ4x160_levels[bc];
+                den += kQ4x160_levels[bc]*kQ4x160_levels[bc];
+            }
+            s = den > 0.0f ? num/den : 0.0f;
+        }
+
+        y[i].d = GGML_FP32_TO_FP16(s);
+        const float sd = GGML_FP16_TO_FP32(y[i].d);
+
+        memset(y[i].qs, 0, sizeof(y[i].qs));
+        for (int j = 0; j < QK4X160; j++) {
+            float best = fabsf(xb[j] - sd*kQ4x160_levels[0]);
+            int bc = 0;
+            for (int l = 1; l < 16; l++) {
+                const float dist = fabsf(xb[j] - sd*kQ4x160_levels[l]);
+                if (dist < best) { best = dist; bc = l; }
+            }
+            const int jj = j < QK4X160/2 ? j : j - QK4X160/2;  // byte index
+            const int sh = j < QK4X160/2 ? 0 : 4;              // low/high nibble
+            y[i].qs[jj] |= (uint8_t) bc << sh;
+        }
+    }
+}
+
+void dequantize_row_q4x160(const block_q4x160 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK4X160 == 0);
+    const int64_t nb = k / QK4X160;
+
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = GGML_FP16_TO_FP32(x[i].d);
+
+        for (int j = 0; j < QK4X160/2; j++) {
+            const int lo = x[i].qs[j] & 0x0F;
+            const int hi = x[i].qs[j] >> 4;
+            y[i*QK4X160 + j]             = kQ4x160_levels[lo] * d;
+            y[i*QK4X160 + j + QK4X160/2] = kQ4x160_levels[hi] * d;
+        }
+    }
+}
+
+size_t quantize_q4x160(const float * GGML_RESTRICT src, void * GGML_RESTRICT dst, int64_t nrow, int64_t n_per_row, const float * quant_weights) {
+    (void)quant_weights; // table rows are quantized from their own values; an imatrix has no role
+    const size_t row_size = ggml_row_size(GGML_TYPE_Q4X160, n_per_row);
+    char * qrow = (char *)dst;
+    for (int64_t row = 0; row < nrow; ++row) {
+        quantize_row_q4x160_ref(src, (block_q4x160 *)qrow, n_per_row);
+        src  += n_per_row;
+        qrow += row_size;
+    }
+    return nrow * row_size;
+}
